# Copy to .env and fill in values. .env is git-ignored.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legal_portal
POSTGRES_USER=legal_portal
POSTGRES_PASSWORD=change-me
# API docs: GET /v3/api-docs and GET /scalar (default true; set false to turn off)
OPENAPI_ENABLED=true
SCALAR_ENABLED=true
# Hibernate SQL logging: DEBUG logs each executed SQL statement (default INFO: not logged)
SQL_LOG_LEVEL=DEBUG
